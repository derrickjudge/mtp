generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  photos        Photo[]
  articles      Article[]
  events        Event[]
}

model Photo {
  id          String      @id @default(cuid())
  title       String
  description String?
  url         String
  thumbnail   String?
  categories  Category[]  @relation("PhotoCategories")
  tags        Tag[]       @relation("PhotoTags")
  events      Event[]     @relation("EventPhotos")
  articles    Article[]
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  author      User        @relation(fields: [authorId], references: [id])
  authorId    String
}

model Article {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String
  // How `content` was authored: "TEXT" (blank-line separated plain text, the
  // default) or "HTML" (hand-written markup). Read by renderArticleContent in
  // src/lib/articleContent.ts, which escapes the former and sanitizes the
  // latter before rendering.
  contentFormat String    @default("TEXT")
  excerpt     String?
  coverImage  String?
  publishDate DateTime?
  categories  Category[]  @relation("ArticleCategories")
  tags        Tag[]       @relation("ArticleTags")
  events      Event[]     @relation("EventArticles")
  // Curated photo set shown as an inline gallery on the article page. Unnamed
  // so Prisma's default junction name (_ArticleToPhoto) matches the table
  // created by ensureJunctionTables(). The per-article display order lives in
  // that table's `position` column, which Prisma cannot express on an implicit
  // m-n relation; ordering is handled by nativeDB.linkArticleToPhotos and
  // getArticleWithRelations.
  photos      Photo[]
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Free-text byline, independent of any User account (e.g. guest/freelance
  // contributors). Falls back to "Anonymous Author" when blank.
  authorName  String?
  // Internal creator reference (which admin account created the article);
  // no longer used as the public byline.
  author      User        @relation(fields: [authorId], references: [id])
  authorId    String
}

model Event {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  date        DateTime?
  location    String?
  coverImage  String?
  photos      Photo[]     @relation("EventPhotos")
  articles    Article[]   @relation("EventArticles")
  categories  Category[]  @relation("EventCategories")
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  author      User        @relation(fields: [authorId], references: [id])
  authorId    String
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  showInNav   Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  photos      Photo[]    @relation("PhotoCategories")
  articles    Article[]  @relation("ArticleCategories")
  events      Event[]    @relation("EventCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  photos      Photo[]   @relation("PhotoTags")
  articles    Article[] @relation("ArticleTags")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Role {
  USER
  EDITOR
  ADMIN
} 